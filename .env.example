# Server Port
PORT=3001

# Supabase (Optional - in-memory fallback enabled when omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Deployment
# Comma-separated frontend URLs allowed by CORS, e.g. https://chess-mind.vercel.app
CORS_ORIGINS=
# Long random string used to sign ownership tokens (set this on hosts with ephemeral disks)
OWNERSHIP_SECRET=
# Optional: smaller engine for low-memory hosts (lite-single). Defaults to lite-single on Render.
STOCKFISH_VARIANT=
